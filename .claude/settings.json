{
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(ruff *)",
      "Bash(pytest *)",
      "Bash(pyright *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(gh issue *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gcloud config *)",
      "Bash(gcloud auth list*)",
      "Bash(gcloud auth print-access-token*)",
      "Bash(gcloud services list*)",
      "Bash(gcloud * list*)",
      "Bash(gcloud * describe*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(jq *)",
      "Read(*)",
      "Edit(*)",
      "Write(*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Edit(.claude/billable-approvals.txt)",
      "Write(.claude/billable-approvals.txt)",
      "Bash(*billable-approvals*)",
      "Edit(ci/wif-provider-flags.yaml)",
      "Write(ci/wif-provider-flags.yaml)",
      "Bash(gcloud projects delete*)",
      "Bash(gcloud sql instances delete*)",
      "Bash(gcloud run services delete*)",
      "Bash(gcloud iam service-accounts keys create*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(rm -rf /*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/credentials*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/billable_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
