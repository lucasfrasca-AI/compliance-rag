# Copy to .env and fill in. .env is gitignored. Never paste values into chat.

# --- Google Cloud ---
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_REGION=australia-southeast1
# Claude on Vertex (ADR-0023): not served from australia-southeast1. Build phase
# only: claude-sonnet-5 at the US multi-region endpoint (ADR-0024), behind a gate
# that refuses real tenant data. VERTEX_CLAUDE_REGION accepts australia-southeast1
# or us only — `global` and every other region are refused. Unset means Sydney.
VERTEX_CLAUDE_MODEL=claude-sonnet-5
VERTEX_CLAUDE_REGION=us
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_EMBEDDING_DIMS=1536
# CI-only, us-central1. Hard-gated to TENANT_ID=dev-tenant.
VERTEX_RANKING_MODEL=semantic-ranker-default-004
VERTEX_RANKING_REGION=us-central1

# --- Reranker (Cloud Run, Sydney; Phase 1). Local: http://localhost:8081 ---
RERANKER_BACKEND=cross_encoder      # cross_encoder | colbert | vertex_ci
RERANKER_URL=http://localhost:8081
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_TOKENS=512
# Filled in Phase 1 after the ask
CORPUS_BUCKET=

# --- Neo4j AuraDB Free ---
NEO4J_INSTANCE_NAME=
NEO4J_INSTANCE_ID=
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Qdrant Cloud Free ---
QDRANT_CLUSTER_NAME=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clauses

# --- Ledger (local Docker in Phase 0-1; Cloud SQL from Phase 3) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance_rag

# --- Telemetry: OpenTelemetry → Cloud Logging regional bucket (Sydney). The only sink. ---
OTEL_SERVICE_NAME=compliance-rag
# Allowed: gcp_logging | stdout. Anything else, or any endpoint outside australia-southeast1, refuses to start.
OTEL_SINKS=gcp_logging
GCP_LOG_BUCKET=compliance-rag-logs
# Later, by ADR only (Phoenix planned; self-hosted Langfuse unlikely):
# PHOENIX_URL=

# --- Web fallback (Phase 3) ---
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_API_KEY=

# --- Project ---
TENANT_ID=dev-tenant
ENV=local

# gcloud: never offer an interactive "API not enabled — enable and retry? (y/N)"
# prompt. That offer enables a billable-protocol resource without ever running
# `gcloud services enable`, so the PreToolUse hook in .claude/hooks/billable_guard.py
# cannot see it. Non-interactive mode makes gcloud fail with an error instead.
CLOUDSDK_CORE_DISABLE_PROMPTS=1
