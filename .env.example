# Copy to .env and fill in. .env is gitignored. Never paste values into chat.

# --- Google Cloud ---
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_REGION=australia-southeast1
# Generation (ADR-0057). GENERATION_BACKEND=gemini | claude | demo.
#   gemini (the default): Gemini 3.5 Flash on Vertex, built through the
#     residency gate (ADR-0023).
#   claude: Claude on Vertex through the same gate. Dormant until Claude is
#     approved on this project; see the commented VERTEX_CLAUDE_* below.
#   demo: the in-process stand-in that calls no model (#292); it requires both
#     regions to be australia-southeast1 (their default), and every page says
#     it is fake.
GENERATION_BACKEND=gemini
GEMINI_MODEL=gemini-3.5-flash
# Gemini 3.5 Flash is not served from australia-southeast1. Build phase only:
# the US multi-region endpoint, behind a gate that refuses real tenant data
# (ADR-0023, ADR-0032). GEMINI_REGION accepts australia-southeast1 or us only —
# `global` and every other region are refused. Unset means Sydney (fail
# closed). This line is uncommented on purpose: the model is not served from
# Sydney, so the default would leave a working deployment with no model.
GEMINI_REGION=us
# Dormant (GENERATION_BACKEND=claude only): claude-sonnet-5 at the same US
# multi-region endpoint (ADR-0024), same gates and same region rule.
# VERTEX_CLAUDE_MODEL=claude-sonnet-5
# VERTEX_CLAUDE_REGION=us
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_EMBEDDING_DIMS=1536
# CI-only, us-central1. Hard-gated to TENANT_ID=dev-tenant.
VERTEX_RANKING_MODEL=semantic-ranker-default-004
VERTEX_RANKING_REGION=us-central1

# --- Reranker (Cloud Run, Sydney; Phase 1). Local: http://localhost:8081 ---
RERANKER_BACKEND=cross_encoder      # cross_encoder | colbert | vertex_ci
RERANKER_URL=http://localhost:8081
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_TOKENS=512
# Filled in Phase 1 after the ask
CORPUS_BUCKET=

# --- Neo4j AuraDB Free ---
# Copy all five values from the credentials file Aura downloads when the
# instance is created; it is authoritative. On Aura Free the username AND the
# database name are both the instance ID (e.g. 5b790f49) — never "neo4j".
# Neither has a default in settings.py, so a missing value fails loudly.
NEO4J_INSTANCE_NAME=
NEO4J_INSTANCE_ID=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# --- Qdrant Cloud Free ---
QDRANT_CLUSTER_NAME=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clauses

# --- Ledger (local Docker in Phase 0-1; Cloud SQL from Phase 3) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance_rag

# --- Telemetry: OpenTelemetry → Cloud Logging regional bucket (Sydney). The only sink. ---
OTEL_SERVICE_NAME=compliance-rag
# Allowed: gcp_logging | stdout. Anything else, or any endpoint outside australia-southeast1, refuses to start.
OTEL_SINKS=gcp_logging
GCP_LOG_BUCKET=compliance-rag-logs
# Later, by ADR only (Phoenix planned; self-hosted Langfuse unlikely):
# PHOENIX_URL=

# --- API sign-in (Phase 3, #146) ---
# The Firebase project whose ID tokens the API accepts; required in ENV=cloud.
FIREBASE_PROJECT_ID=
# Comma-separated verified emails admitted to TENANT_ID. Empty admits no one.
API_MEMBERS=
# Comma-separated emails of members who are also admins (subscription writes, profile
# evidence). An admin must also be in API_MEMBERS. Read on every request. Empty: no admins.
API_ADMINS=
# Sign-in providers whose verified email is trusted.
API_SIGN_IN_PROVIDERS=google.com,password
# The sign-in page (#280): the Firebase web API key (not a secret) and, if it
# isn't <project>.firebaseapp.com, the auth domain.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Signs the session cookie: 32+ random characters (`openssl rand -base64 48`).
# Secret Manager in Cloud Run. Empty: cookie sessions are off.
SESSION_SECRET=
# Extra origins (https://host, comma-separated) allowed to POST with the cookie.
API_ALLOWED_ORIGINS=
# Serve /docs and /openapi.json (local development only).
API_DOCS=false
# While generation is offshore (GEMINI_REGION=us), the only members whose
# questions are sent to the model: build-phase testers, who ask about public law
# and synthetic data only (ADR-0032). Empty: none. Ignored in
# australia-southeast1, where nothing leaves Australia.
OFFSHORE_GENERATION_TESTERS=

# --- Web fallback (Phase 3) ---
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_API_KEY=

# --- Project ---
TENANT_ID=dev-tenant
ENV=local

# gcloud: never offer an interactive "API not enabled — enable and retry? (y/N)"
# prompt. That offer enables a billable-protocol resource without ever running
# `gcloud services enable`, so the PreToolUse hook in .claude/hooks/billable_guard.py
# cannot see it. Non-interactive mode makes gcloud fail with an error instead.
CLOUDSDK_CORE_DISABLE_PROMPTS=1
